# سُحُب التقنية | so7ob — متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك.
# ⚠️ لا تضع قيمًا حقيقية سرية في المستودع — هذا الملف للتوثيق فقط.

# قاعدة البيانات (SQLite محلي — المسار نسبي لمجلد prisma/)
DATABASE_URL="file:../db/custom.db"

# رابط الموقع العام — يُستخدم للبيانات الوصفية وOpen Graph وsitemap
# اضبطه على النطاق الفعلي عند النشر، بدون شرطة مائلة أخيرة.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# (اختياري) Webhook لإشعار المسؤول عند وصول طلب جديد.
# يُرسل POST JSON إلى الرابط عند كل طلب محفوظ بنجاح.
# اتركه فارغًا للتعطيل — لا يؤثر غيابه على الحفظ الدائم.
NOTIFY_WEBHOOK_URL=""
